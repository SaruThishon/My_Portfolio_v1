---
import '../styles/admin.css';
interface Props { title?: string; activePage?: string; unreadEnquiries?: number; }
const { title='Admin', activePage='', unreadEnquiries=0 } = Astro.props;
const sessionToken = Astro.cookies.get('session_token');
const currentPath = Astro.url.pathname;
const isPublicAdminPage = currentPath === '/admin/login' || currentPath === '/admin/logout';
if (!sessionToken?.value && !isPublicAdminPage) return Astro.redirect('/admin/login');
const nav = [
  {href:'/admin', page:'dashboard', label:'Dashboard', icon:'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z'},
  {href:'/admin/enquiries', page:'enquiries', label:'Enquiries', icon:'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'},
  {href:'/admin/projects', page:'projects', label:'Projects', icon:'M3 3h18v18H3z'},
  {href:'/admin/skills', page:'skills', label:'Skills', icon:'m12 2-3.6 7.4L1 10.5l5.5 5.4-1.3 7.6L12 20l6.8 3.5-1.3-7.6 5.5-5.4-7.4-1.1z'},
  {href:'/admin/education', page:'education', label:'Education', icon:'M22 10v6M2 10l10-5 10 5-10 5z M6 12v5c3 3 9 3 12 0v-5'},
  {href:'/admin/experience', page:'experience', label:'Experience', icon:'M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z'},
  {href:'/admin/certifications', page:'certifications', label:'Certifications', icon:'M12 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z M9 22l3-9 3 9'},
  {href:'/admin/resume', page:'resume', label:'Resume', icon:'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6'},
  {href:'/admin/media', page:'media', label:'Media', icon:'M3 3h18v18H3z M8.5 8.5a.5.5 0 1 0 0-1 M21 15l-5-5L5 21'},
  {href:'/admin/profile', page:'profile', label:'Profile', icon:'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z'},
  {href:'/admin/settings', page:'settings', label:'Settings', icon:'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z'},
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{title} — Portfolio Admin</title>
<meta name="robots" content="noindex, nofollow"/>
</head>
<body>

<!-- Mobile header (only visible on small screens) -->
<header class="admin-mobile-header" id="mobile-header">
  <div class="admin-mobile-logo">
    <span class="admin-mobile-logo-mark">◆</span>
    Portfolio Admin
  </div>
  <button class="admin-hamburger" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- Overlay backdrop for mobile sidebar -->
<div class="admin-sidebar-overlay" id="sidebar-overlay"></div>

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
    <div class="sidebar-logo">
      <a href="/admin"><span class="sidebar-logo-mark">◆</span> Portfolio Admin</a>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Overview</div>
      {nav.slice(0,2).map(item => (
        <a href={item.href} class={`sidebar-link ${activePage===item.page?'active':''}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={item.icon}/></svg>
          {item.label}
          {item.page==='enquiries' && unreadEnquiries>0 && <span class="sidebar-badge">{unreadEnquiries}</span>}
        </a>
      ))}
      <div class="sidebar-section-label">Content</div>
      {nav.slice(2,9).map(item => (
        <a href={item.href} class={`sidebar-link ${activePage===item.page?'active':''}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={item.icon}/></svg>
          {item.label}
        </a>
      ))}
      <div class="sidebar-section-label">Account</div>
      {nav.slice(9).map(item => (
        <a href={item.href} class={`sidebar-link ${activePage===item.page?'active':''}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={item.icon}/></svg>
          {item.label}
        </a>
      ))}
      <form action="/admin/logout" method="POST" style="margin:0;padding:0">
        <button type="submit" class="sidebar-link" style="width:100%;background:none;border:none;text-align:left;cursor:pointer;color:#A9A1B1;font-size:14px;font-weight:500;display:flex;align-items:center;gap:.75rem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </button>
      </form>
    </nav>
  </aside>

  <!-- Main content area -->
  <main class="admin-main">
    <slot />
  </main>
</div>

<script>
  // Mobile sidebar toggle
  const btn = document.getElementById('mobile-menu-btn');
  const sidebar = document.getElementById('admin-sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function openSidebar() {
    sidebar?.classList.add('mobile-open');
    overlay?.classList.add('open');
    btn?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar?.classList.remove('mobile-open');
    overlay?.classList.remove('open');
    btn?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.contains('mobile-open');
    isOpen ? closeSidebar() : openSidebar();
  });

  overlay?.addEventListener('click', closeSidebar);

  // Close sidebar when a nav link is clicked on mobile
  sidebar?.querySelectorAll('a, button[type="submit"]').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) closeSidebar();
    });
  });
</script>

</body>
</html>
