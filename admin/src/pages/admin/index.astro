---
import AdminLayout from '../../layouts/AdminLayout.astro';

const API = 'http://localhost:8000';
const session = Astro.cookies.get('session_token');
const sessionVal = session?.value ?? '';
const headers: Record<string, string> = { Cookie: `session_token=${sessionVal}`, 'Content-Type': 'application/json' };

let stats: any = null;
let activityLogs: any[] = [];
let enquiryStats: any = null;
let presence: any = { is_online: true, last_login: null };

try {
  const [statsRes, logsRes, enqStatsRes, presenceRes] = await Promise.all([
    fetch(`${API}/api/admin/dashboard-stats`, { headers }),
    fetch(`${API}/api/admin/activity-logs?limit=8`, { headers }),
    fetch(`${API}/api/enquiries/stats`, { headers }),
    fetch(`${API}/api/admin/presence`, { headers }),
  ]);
  if (statsRes.ok) stats = await statsRes.json();
  if (logsRes.ok) activityLogs = await logsRes.json();
  if (enqStatsRes.ok) enquiryStats = await enqStatsRes.json();
  if (presenceRes.ok) presence = await presenceRes.json();
} catch {}

const unread = enquiryStats?.unread ?? 0;

function timeAgo(iso: string) {
  const diff = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}
---
<AdminLayout title="Dashboard" activePage="dashboard" unreadEnquiries={unread}>
  <div class="admin-topbar">
    <div>
      <div class="admin-topbar-title">Dashboard</div>
    </div>
    <div class="admin-topbar-actions">
      <a href="http://localhost:4321" target="_blank" class="topbar-btn">View Site ↗</a>
    </div>
  </div>
  <div class="admin-content">
    <!-- Stats -->
    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card__label">Total Projects</div>
        <div class="stat-card__value">{stats?.projects?.total ?? '—'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Published</div>
        <div class="stat-card__value stat-card__accent">{stats?.projects?.published ?? '—'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Drafts</div>
        <div class="stat-card__value">{stats?.projects?.drafts ?? '—'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">New Enquiries</div>
        <div class="stat-card__value stat-card__accent">{stats?.enquiries?.new ?? '—'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Total Enquiries</div>
        <div class="stat-card__value">{stats?.enquiries?.total ?? '—'}</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem">
      <!-- Recent Enquiries -->
      <div>
        <div class="page-header" style="margin-bottom:1rem">
          <h2 style="font-size:16px;font-weight:600;color:#F5F0FA">Recent Enquiries</h2>
          <a href="/admin/enquiries" class="btn btn--ghost btn--sm">View all</a>
        </div>
        {(!stats?.recent_enquiries || stats.recent_enquiries.length === 0) ? (
          <div class="empty-state" style="padding:2rem"><p>No enquiries yet.</p></div>
        ) : (
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>From</th><th>Subject</th><th>Status</th><th>Time</th></tr></thead>
              <tbody>
                {stats.recent_enquiries.map((e: any) => (
                  <tr>
                    <td style="color:#F5F0FA;font-weight:500">{e.name}</td>
                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{e.subject}</td>
                    <td>
                      <span class={`badge ${e.status==='new'?'badge--violet':e.status==='replied'?'badge--green':'badge--gray'}`}>
                        {e.status}
                      </span>
                    </td>
                    <td style="font-size:12px">{timeAgo(e.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- Activity Log -->
      <div>
        <div class="page-header" style="margin-bottom:1rem">
          <h2 style="font-size:16px;font-weight:600;color:#F5F0FA">Recent Activity</h2>
        </div>
        {activityLogs.length === 0 ? (
          <div class="empty-state" style="padding:2rem"><p>No activity yet.</p></div>
        ) : (
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>Action</th><th>Entity</th><th>Time</th></tr></thead>
              <tbody>
                {activityLogs.map((log: any) => (
                  <tr>
                    <td style="color:#F5F0FA;font-weight:500;font-size:12px">{log.action.replace(/_/g,' ')}</td>
                    <td style="font-size:12px">{log.entity_type ?? '—'}</td>
                    <td style="font-size:11px;color:#6B6475">{timeAgo(log.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <!-- Quick links -->
    <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
      <a href="/admin/projects/new" class="btn btn--primary">+ New Project</a>
      <a href="/admin/enquiries" class="btn btn--ghost">View Enquiries {unread > 0 && `(${unread} new)`}</a>
      <a href="/admin/profile" class="btn btn--ghost">Edit Profile</a>
      <a href="/admin/resume" class="btn btn--ghost">Manage Resume</a>
    </div>

    <!-- Presence Card -->
    <div style="margin-top:2rem;background:#19161F;border:1px solid #35303D;border-radius:12px;padding:1.5rem;max-width:420px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <h3 style="font-size:14px;font-weight:600;color:#F5F0FA">Public Presence</h3>
        <span style="font-size:11px;color:#6B6475;letter-spacing:.05em;text-transform:uppercase">Hero indicator</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem">
        <div style="display:flex;align-items:center;gap:.75rem">
          <div
            id="presence-dot"
            style={`width:10px;height:10px;border-radius:50%;background:${presence.is_online ? '#4ADE80' : '#6B6475'};box-shadow:${presence.is_online ? '0 0 0 3px rgba(74,222,128,.2)' : 'none'};flex-shrink:0`}
          ></div>
          <div>
            <div id="presence-label" style={`font-size:14px;font-weight:600;color:${presence.is_online ? '#4ADE80' : '#A9A1B1'}`}>
              {presence.is_online ? 'Online' : 'Offline'}
            </div>
            {!presence.is_online && presence.last_login && (
              <div id="presence-sublabel" style="font-size:11px;color:#6B6475;margin-top:2px">
                Last seen: {timeAgo(presence.last_login)}
              </div>
            )}
            {presence.is_online && (
              <div style="font-size:11px;color:#6B6475;margin-top:2px">Visible on the public portfolio</div>
            )}
          </div>
        </div>
        <button
          id="presence-toggle"
          class={`btn btn--sm ${presence.is_online ? 'btn--ghost' : 'btn--primary'}`}
          data-is-online={String(presence.is_online)}
        >
          {presence.is_online ? 'Go Offline' : 'Go Online'}
        </button>
      </div>
      <div id="presence-status" style="margin-top:.75rem;font-size:12px;min-height:1em"></div>
    </div>
  </div>
</AdminLayout>

<script>
(function() {
  const btn = document.getElementById('presence-toggle') as HTMLButtonElement | null;
  const dot = document.getElementById('presence-dot') as HTMLElement | null;
  const label = document.getElementById('presence-label') as HTMLElement | null;
  const status = document.getElementById('presence-status') as HTMLElement | null;
  if (!btn || !dot || !label) return;

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'Updating...';
    if (status) { status.textContent = ''; }

    try {
      const r = await fetch('/api/proxy', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ method: 'PATCH', path: '/api/admin/presence' }),
      });
      const d = await r.json();
      if (r.ok) {
        const isOnline = d.is_online as boolean;
        // Update dot colour
        dot.style.background = isOnline ? '#4ADE80' : '#6B6475';
        dot.style.boxShadow  = isOnline ? '0 0 0 3px rgba(74,222,128,.2)' : 'none';
        // Update label
        label.textContent  = isOnline ? 'Online' : 'Offline';
        label.style.color  = isOnline ? '#4ADE80' : '#A9A1B1';
        // Update button
        btn.textContent = isOnline ? 'Go Offline' : 'Go Online';
        btn.className   = `btn btn--sm ${isOnline ? 'btn--ghost' : 'btn--primary'}`;
        btn.dataset.isOnline = String(isOnline);
        if (status) {
          status.textContent = isOnline
            ? '✓ Now showing as Online on your portfolio.'
            : '✓ Now showing as Offline. Last seen time will be displayed.';
          status.style.color = '#4ADE80';
        }
      } else {
        if (status) { status.textContent = 'Failed to update. Try again.'; status.style.color = '#F87171'; }
      }
    } catch {
      if (status) { status.textContent = 'Network error.'; status.style.color = '#F87171'; }
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>
