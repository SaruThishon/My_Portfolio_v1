---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { BACKEND_URL as API } from '../../../lib/config';
const { id } = Astro.params;
const session = Astro.cookies.get('session_token');
const h: Record<string, string> = { Cookie: `session_token=${session?.value ?? ''}`, 'Content-Type': 'application/json' };
let enquiry: any = null;
let error = '';
try {
  const r = await fetch(`${API}/api/enquiries/${id}`, { headers: h });
  if (r.ok) enquiry = await r.json(); else error = 'Not found';
} catch { error = 'Connection error'; }

if (Astro.request.method === 'POST' && enquiry) {
  const form = await Astro.request.formData();
  const status = form.get('status') as string;
  if (status) {
    try {
      const r = await fetch(`${API}/api/enquiries/${id}/status`, {
        method: 'PATCH', headers: h, body: JSON.stringify({ status }),
      });
      if (r.ok) { enquiry = await r.json(); }
    } catch {}
  }
}
---
<AdminLayout title="Enquiry" activePage="enquiries">
  <div class="admin-topbar">
    <div class="admin-topbar-title">Enquiry Detail</div>
    <div class="admin-topbar-actions"><a href="/admin/enquiries" class="btn btn--ghost">← Enquiries</a></div>
  </div>
  <div class="admin-content" style="max-width:720px">
    {error && <div class="alert alert--error">{error}</div>}
    {enquiry && (
      <div>
        <div style="background:#19161F;border:1px solid #35303D;border-radius:12px;padding:1.5rem;margin-bottom:1.5rem">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
            <div><div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem">From</div><div style="color:#F5F0FA;font-weight:600">{enquiry.name}</div><div style="color:#A9A1B1;font-size:13px">{enquiry.email}</div></div>
            <div><div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem">Type</div><div style="color:#F5F0FA">{enquiry.enquiry_type.replace(/_/g,' ')}</div></div>
            <div><div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem">Date</div><div style="color:#F5F0FA">{new Date(enquiry.created_at).toLocaleString()}</div></div>
            <div><div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem">Status</div><span class={`badge ${enquiry.status==='new'?'badge--violet':enquiry.status==='replied'?'badge--green':'badge--gray'}`}>{enquiry.status}</span></div>
          </div>
          <div style="border-top:1px solid #35303D;padding-top:1.25rem">
            <div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem">Subject</div>
            <div style="font-size:16px;font-weight:600;color:#F5F0FA;margin-bottom:1.25rem">{enquiry.subject}</div>
            <div style="font-size:11px;color:#6B6475;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem">Message</div>
            <div style="color:#A9A1B1;line-height:1.8;white-space:pre-wrap">{enquiry.message}</div>
          </div>
        </div>
        <!-- Actions -->
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
          <a href={`mailto:${enquiry.email}?subject=Re: ${enquiry.subject}`} class="btn btn--primary">Reply via Email</a>
          {enquiry.status !== 'replied' && (
            <form method="POST" style="display:inline">
              <input type="hidden" name="status" value="replied"/>
              <button type="submit" class="btn btn--ghost">Mark as Replied</button>
            </form>
          )}
          {enquiry.status !== 'archived' && (
            <form method="POST" style="display:inline">
              <input type="hidden" name="status" value="archived"/>
              <button type="submit" class="btn btn--ghost">Archive</button>
            </form>
          )}
          {enquiry.status === 'archived' && (
            <form method="POST" style="display:inline">
              <input type="hidden" name="status" value="read"/>
              <button type="submit" class="btn btn--ghost">Unarchive</button>
            </form>
          )}
        </div>
      </div>
    )}
  </div>
</AdminLayout>
