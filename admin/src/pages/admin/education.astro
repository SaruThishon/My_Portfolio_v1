---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { BACKEND_URL as API } from '../../lib/config';
const session = Astro.cookies.get('session_token');
const h: Record<string, string> = { Cookie: `session_token=${session?.value ?? ''}`, 'Content-Type': 'application/json' };
let items: any[] = [];
let error = '';
let success = '';
try { const r = await fetch(`${API}/api/education`, { headers: h }); if (r.ok) items = await r.json(); } catch { error = 'Connection error'; }

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;
  if (action === 'create') {
    const payload = {
      institution: form.get('institution'), degree: form.get('degree'),
      field_of_study: form.get('field_of_study') || null,
      start_date: form.get('start_date') || null, end_date: form.get('end_date') || null,
      is_current: form.get('is_current') === 'on',
      description: form.get('description') || null, grade: form.get('grade') || null,
      display_order: parseInt(form.get('display_order') as string) || 0,
    };
    try {
      const r = await fetch(`${API}/api/education`, { method: 'POST', headers: h, body: JSON.stringify(payload) });
      if (r.ok) { items = [...items, await r.json()]; success = 'Added!'; }
      else { const d = await r.json(); error = d.detail || 'Failed'; }
    } catch { error = 'Connection error'; }
  } else if (action === 'delete') {
    const id = form.get('id');
    try {
      const r = await fetch(`${API}/api/education/${id}`, { method: 'DELETE', headers: h });
      if (r.ok) { items = items.filter((e: any) => e.id !== id); success = 'Deleted!'; }
      else error = 'Failed';
    } catch { error = 'Connection error'; }
  }
}
---
<AdminLayout title="Education" activePage="education">
  <div class="admin-topbar"><div class="admin-topbar-title">Education</div></div>
  <div class="admin-content">
    {error && <div class="alert alert--error">{error}</div>}
    {success && <div class="alert alert--success">{success}</div>}
    <div style="display:grid;grid-template-columns:380px 1fr;gap:2rem;align-items:start">
      <!-- Add form -->
      <div style="background:#19161F;border:1px solid #35303D;border-radius:12px;padding:1.5rem">
        <h3 style="font-size:16px;font-weight:600;margin-bottom:1.25rem">Add Education</h3>
        <form method="POST">
          <input type="hidden" name="_action" value="create"/>
          <div class="form-group"><label class="form-label">Institution *</label><input name="institution" class="form-input" required placeholder="MIT, IIT Delhi…"/></div>
          <div class="form-group"><label class="form-label">Degree *</label><input name="degree" class="form-input" required placeholder="B.Tech, B.Sc…"/></div>
          <div class="form-group"><label class="form-label">Field of Study</label><input name="field_of_study" class="form-input" placeholder="Computer Science"/></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
            <div class="form-group"><label class="form-label">Start Date</label><input name="start_date" class="form-input" type="date"/></div>
            <div class="form-group"><label class="form-label">End Date</label><input name="end_date" class="form-input" type="date"/></div>
          </div>
          <div class="form-group"><label class="form-label">Grade / CGPA</label><input name="grade" class="form-input" placeholder="8.5 / 10"/></div>
          <div class="form-group"><label class="form-label">Description</label><textarea name="description" class="form-input form-textarea" rows="3" placeholder="Relevant coursework, achievements…"></textarea></div>
          <div class="form-group"><label class="form-label">Display Order</label><input name="display_order" class="form-input" type="number" value="0"/></div>
          <div class="form-group"><label style="display:flex;align-items:center;gap:.5rem;cursor:pointer"><input type="checkbox" name="is_current" style="accent-color:#B794F6;width:16px;height:16px"/><span class="form-label" style="margin:0">Currently studying</span></label></div>
          <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center">Add</button>
        </form>
      </div>
      <!-- List -->
      <div style="display:flex;flex-direction:column;gap:1rem">
        {items.length === 0 ? (
          <div class="empty-state"><p>No education entries yet.</p></div>
        ) : items.map((edu: any) => (
          <div style="background:#19161F;border:1px solid #35303D;border-radius:12px;padding:1.25rem;display:flex;justify-content:space-between;align-items:start;gap:1rem">
            <div>
              <div style="color:#F5F0FA;font-weight:600">{edu.degree}</div>
              <div style="color:#B794F6;font-size:14px;margin-top:.2rem">{edu.institution}</div>
              {edu.field_of_study && <div style="color:#A9A1B1;font-size:13px">{edu.field_of_study}</div>}
              <div style="font-size:12px;color:#6B6475;margin-top:.25rem">
                {edu.start_date && new Date(edu.start_date).toLocaleDateString('en-US',{year:'numeric',month:'short'})}
                {edu.start_date && ' — '}
                {edu.is_current ? <span style="color:#4ADE80">Present</span> : edu.end_date && new Date(edu.end_date).toLocaleDateString('en-US',{year:'numeric',month:'short'})}
              </div>
              {edu.grade && <div style="font-size:12px;color:#A9A1B1;margin-top:.25rem">Grade: {edu.grade}</div>}
            </div>
            <form method="POST" style="flex-shrink:0">
              <input type="hidden" name="_action" value="delete"/>
              <input type="hidden" name="id" value={edu.id}/>
              <button type="submit" class="btn btn--danger btn--sm" onclick="return confirm('Delete?')">Delete</button>
            </form>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
