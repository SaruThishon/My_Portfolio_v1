---
import { BACKEND_URL } from '../../lib/config';
// Handle POST logout — call API, clear cookie, redirect to login
if (Astro.request.method === 'POST') {
  const sessionToken = Astro.cookies.get('session_token');
  if (sessionToken?.value) {
    try {
      // Tell the backend to invalidate this session in the database
      await fetch(`${BACKEND_URL}/api/auth/logout`, {
        method: 'POST',
        headers: {
          'Cookie': `session_token=${sessionToken.value}`,
          'Content-Type': 'application/json',
        },
      });
    } catch {
      // Even if the API call fails, we still clear the local cookie
    }
    Astro.cookies.delete('session_token', { path: '/' });
  }
  return Astro.redirect('/admin/login');
}
// GET requests just redirect to login
return Astro.redirect('/admin/login');
---
