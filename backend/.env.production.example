# ── Backend production environment variables ──────────────────────────────────
# Set ALL of these in Vercel → Project → Settings → Environment Variables

# Database (Supabase)
# Get from: Supabase → Project → Settings → Database → URI (use Transaction mode: port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_string
SESSION_EXPIRE_DAYS=7

# Admin account (used only by scripts/create_admin.py — not auto-created on Vercel)
ADMIN_USERNAME=admin
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=replace_with_strong_password

# File Storage (Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://[account_id].r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_r2_access_key
STORAGE_SECRET_KEY=your_r2_secret_key
STORAGE_BUCKET=portfolio
STORAGE_PUBLIC_URL=https://pub-[id].r2.dev
STORAGE_REGION=auto

# URLs — fill in after Vercel deployments are created
PUBLIC_API_URL=https://your-backend.vercel.app
PUBLIC_SITE_URL=https://your-frontend.vercel.app
ADMIN_FRONTEND_URL=https://your-admin.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Environment
ENVIRONMENT=production

# Build webhook (optional — used by admin "Trigger Build" button)
BUILD_HOOK_SECRET=replace_with_random_string
BUILD_HOOK_URL=

# Rate limiting
CONTACT_RATE_LIMIT=5
LOGIN_RATE_LIMIT=5
