# ═══════════════════════════════════════════════════════════════════════════════
# PORTFOLIO PLATFORM — ENVIRONMENT VARIABLES REFERENCE
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: postgresql+asyncpg://portfolio_user:portfolio_pass@localhost:5432/portfolio_db
# Production (Neon): postgresql+asyncpg://user:pass@host/db?ssl=require
DATABASE_URL=postgresql+asyncpg://portfolio_user:portfolio_pass@localhost:5432/portfolio_db

# ─── Application Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_replace_with_256bit_random_hex_string
SESSION_EXPIRE_DAYS=7

# ─── First Admin Account (used by scripts/create_admin.py) ───────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_use_strong_password

# ─── File Storage (MinIO locally / Cloudflare R2 in production) ───────────────
# Local MinIO:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=portfolio
STORAGE_PUBLIC_URL=http://localhost:9000/portfolio
STORAGE_REGION=us-east-1

# Production Cloudflare R2:
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=<r2_access_key>
# STORAGE_SECRET_KEY=<r2_secret_key>
# STORAGE_BUCKET=portfolio
# STORAGE_PUBLIC_URL=https://pub-<id>.r2.dev
# STORAGE_REGION=auto

# ─── Email (Mailpit locally / Resend in production) ───────────────────────────
EMAIL_PROVIDER=smtp
# Local Mailpit SMTP:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@portfolio.local
SMTP_FROM_NAME=Portfolio

# Production Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# Admin notification target
NOTIFICATION_EMAIL=admin@example.com

# ─── Analytics (Umami) ────────────────────────────────────────────────────────
UMAMI_API_URL=http://localhost:3001
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# ─── Frontend / Public ────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:4321
ADMIN_FRONTEND_URL=http://localhost:4322

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

# ─── Publishing / Build Hooks ─────────────────────────────────────────────────
# Secret token to authorize build webhook calls
BUILD_HOOK_SECRET=changeme_build_hook_secret
# Optional: Cloudflare Pages deploy hook URL (set in production)
BUILD_HOOK_URL=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max contact form submissions per IP per hour
CONTACT_RATE_LIMIT=5
# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=5

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# development | production
