---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/api';
// No images shown on this page — text-only cards, images only on project detail pages

const projects = await getPublishedProjects() || [];
const title = 'Projects — Portfolio';
const description = 'All projects — built to solve real problems and explore interesting ideas.';
---
<BaseLayout title={title} description={description}>
  <div class="ap-page">
    <div class="container">
      <div class="ap-hdr reveal">
        <span class="section-label">ALL PROJECTS</span>
        <h1 class="ap-h1">Everything I've<br/><span class="text-gradient">built.</span></h1>
      </div>
      {projects.length === 0 ? (
        <div class="ap-empty reveal">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
          <h3>Projects coming soon</h3>
          <p>I'm working on something interesting. Check back soon.</p>
        </div>
      ) : (
        <div class="ap-grid">
          {projects.map((p: any, i: number) => (
            <article class={`apc reveal delay-${Math.min(i+1,4)}`}>
              <a href={`/projects/${p.slug}`} class="apc__link" aria-label={`View ${p.title}`}>
                <div class="apc__top">
                  <span class="apc__cat">{p.category}</span>
                  {p.is_featured && <span class="apc__badge">Featured</span>}
                  <span class="apc__num">0{i+1}</span>
                </div>
                <div class="apc__body">
                  <h3 class="apc__title">{p.title}</h3>
                  <p class="apc__desc">{p.short_description}</p>
                </div>
                <div class="apc__bottom">
                  <div class="apc__tags">
                    {p.technologies.slice(0,5).map((t:string)=><span class="apc__tag">{t}</span>)}
                    {p.technologies.length>5 && <span class="apc__tag">+{p.technologies.length-5}</span>}
                  </div>
                  <span class="apc__arrow" aria-hidden="true">→</span>
                </div>
              </a>
              <span class="apc__br apc__br--tl" aria-hidden="true"></span>
              <span class="apc__br apc__br--br" aria-hidden="true"></span>
            </article>
          ))}
        </div>
      )}
      <div class="ap-back reveal"><a href="/" class="ap-btn">← Back to Home</a></div>
    </div>
  </div>
</BaseLayout>

<style>
.ap-page{padding-top:calc(72px + 3rem);min-height:100vh;padding-bottom:5rem}
.ap-hdr{margin-bottom:3rem}
.ap-h1{font-size:clamp(2.5rem,6vw,4rem);font-weight:700;letter-spacing:-.04em;line-height:1.1;margin-top:1rem}
.ap-back{margin-top:3rem}
.ap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
@media(max-width:1024px){.ap-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.ap-grid{grid-template-columns:1fr}}
.apc{position:relative;border-radius:16px;background:linear-gradient(145deg,#1e1a27,#17141e);border:1px solid rgba(53,48,61,.9);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04),0 4px 20px rgba(0,0,0,.4);transition:border-color .3s,transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s;overflow:hidden}
.apc:hover{border-color:rgba(183,148,246,.45);transform:translateY(-4px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08),0 0 0 1px rgba(183,148,246,.2),0 12px 40px rgba(0,0,0,.55),0 0 50px rgba(183,148,246,.08)}
.apc__link{display:flex;flex-direction:column;padding:1.5rem;text-decoration:none;color:inherit;min-height:220px}
.apc__link:focus-visible{outline:2px solid #B794F6;outline-offset:3px}
.apc__top{display:flex;align-items:center;gap:.5rem;margin-bottom:.875rem}
.apc__cat{font-size:.68rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#6B6475}
.apc__badge{font-size:.62rem;font-weight:700;text-transform:uppercase;color:#B794F6;background:rgba(183,148,246,.1);border:1px solid rgba(183,148,246,.22);padding:.15em .6em;border-radius:9999px}
.apc__num{margin-left:auto;font-family:'Space Grotesk',sans-serif;font-size:1.8rem;font-weight:700;letter-spacing:-.04em;line-height:1;color:rgba(183,148,246,.1);transition:color .3s}
.apc:hover .apc__num{color:rgba(183,148,246,.22)}
.apc__body{flex:1}
.apc__title{font-family:'Space Grotesk',sans-serif;font-size:1.15rem;font-weight:700;color:#F5F0FA;line-height:1.3;margin-bottom:.4rem;transform:translateY(2px);transition:transform .3s cubic-bezier(.16,1,.3,1)}
.apc:hover .apc__title{transform:translateY(0)}
.apc__desc{font-size:.8125rem;color:rgba(169,161,177,.8);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.apc__bottom{display:flex;align-items:flex-end;justify-content:space-between;margin-top:.875rem;gap:.5rem}
.apc__tags{display:flex;flex-wrap:wrap;gap:.3rem;flex:1}
.apc__tag{font-size:.62rem;font-weight:500;color:rgba(183,148,246,.7);background:rgba(183,148,246,.08);border:1px solid rgba(183,148,246,.14);padding:.15em .55em;border-radius:9999px}
.apc__arrow{flex-shrink:0;font-size:1rem;color:#B794F6;opacity:0;transform:translateX(-6px);transition:opacity .25s,transform .3s cubic-bezier(.16,1,.3,1)}
.apc:hover .apc__arrow{opacity:1;transform:translateX(0)}
.apc__br{position:absolute;width:16px;height:16px;border-color:rgba(183,148,246,.6);border-style:solid;opacity:0;z-index:2;transition:opacity .3s,transform .35s cubic-bezier(.16,1,.3,1);pointer-events:none}
.apc__br--tl{top:12px;left:12px;border-width:2px 0 0 2px;transform:translate(-5px,-5px)}
.apc__br--br{bottom:12px;right:12px;border-width:0 2px 2px 0;transform:translate(5px,5px)}
.apc:hover .apc__br{opacity:1;transform:translate(0,0)}
.ap-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:5rem 2rem;text-align:center;border:1px dashed var(--color-border);border-radius:var(--radius-xl);color:var(--color-text-muted)}
.ap-empty h3{font-size:var(--text-xl);color:var(--color-text-secondary)}
.ap-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.6em 1.3em;border-radius:9999px;font-size:1rem;font-weight:600;cursor:pointer;transition:all 220ms;border:1px solid var(--color-border);background:transparent;color:var(--color-text-primary);text-decoration:none;font-family:var(--font-body)}
.ap-btn:hover{border-color:var(--color-accent-primary);color:var(--color-accent-primary);transform:translateY(-2px)}
</style>
