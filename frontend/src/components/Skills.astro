---
import type { Skill } from '../types/api';
interface Props { skills?: Skill[]; }
const { skills = [] } = Astro.props;

// Group by category
const grouped = skills.filter(s => s.is_visible).reduce((acc, skill) => {
  if (!acc[skill.category]) acc[skill.category] = [];
  acc[skill.category].push(skill);
  return acc;
}, {} as Record<string, Skill[]>);

const defaultSkills = [
  { category: 'Programming', items: ['Python', 'SQL'] },
  { category: 'Databases', items: ['PostgreSQL'] },
  { category: 'Data Science', items: ['Pandas', 'NumPy', 'Matplotlib', 'Seaborn'] },
  { category: 'Tools', items: ['Git', 'GitHub', 'Jupyter Notebook', 'VS Code'] },
];
---
<section class="skills section" id="skills" aria-label="Skills section">
  <div class="container">
    <div class="skills__header reveal">
      <span class="section-label">03 / SKILLS</span>
      <h2 class="skills__heading">Tools of the<br/><span class="text-gradient">trade.</span></h2>
    </div>
    <div class="skills__content">
      {Object.keys(grouped).length > 0 ? (
        Object.entries(grouped).map(([category, categorySkills]) => (
          <div class="skills__group reveal">
            <h3 class="skills__group-title">{category}</h3>
            {/* data-stagger triggers wave entrance on the pill children */}
            <div class="skills__tags" data-stagger>
              {categorySkills.map(skill => (
                <div class="skill-pill">
                  <span class="skill-pill__name">{skill.name}</span>
                  {skill.proficiency && <span class="skill-pill__level">{skill.proficiency}</span>}
                </div>
              ))}
            </div>
          </div>
        ))
      ) : (
        defaultSkills.map((group, i) => (
          <div class={`skills__group reveal delay-${i+1}`}>
            <h3 class="skills__group-title">{group.category}</h3>
            <div class="skills__tags" data-stagger>
              {group.items.map(item => (
                <div class="skill-pill"><span class="skill-pill__name">{item}</span></div>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</section>

<style>
.skills__header{margin-bottom:3rem}
.skills__heading{font-size:var(--text-5xl);margin-block:1rem}
.skills__content{display:flex;flex-direction:column;gap:2.5rem}
.skills__group-title{font-size:var(--text-xs);font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem}
.skills__tags{display:flex;flex-wrap:wrap;gap:.75rem}
.skill-pill{
  display:inline-flex;align-items:center;gap:.5rem;
  background:var(--color-bg-card);border:1px solid var(--color-border);
  border-radius:var(--radius-lg);padding:.6em 1.1em;
  transition:border-color var(--transition-fast),transform var(--transition-fast);
}
.skill-pill:hover{border-color:rgba(183,148,246,.5);transform:translateY(-2px)}
.skill-pill__name{font-size:var(--text-sm);font-weight:500;color:var(--color-text-primary)}
.skill-pill__level{font-size:.7rem;font-weight:500;color:var(--color-text-muted);letter-spacing:.05em}
</style>
