---
interface Project {
  id: string; title: string; slug: string; short_description: string;
  category: string; thumbnail_url?: string; technologies: string[];
  is_featured: boolean;
}
interface Props { projects?: Project[]; }
const { projects = [] } = Astro.props;
const cols = Math.min(projects.length, 3);
---
<section class="projects section" id="projects" aria-label="Projects section">
  <div class="container">
    <div class="projects__header reveal">
      <span class="section-label">02 / PROJECTS</span>
      <h2 class="projects__heading">Work that<br/><span class="text-gradient">speaks for itself.</span></h2>
      <p class="projects__subtext">Projects built to solve real problems and explore interesting ideas.</p>
    </div>
    {projects.length === 0 ? (
      <div class="projects__empty reveal">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
        <h3>Projects coming soon</h3>
        <p>Check back soon — I'm building something interesting.</p>
      </div>
    ) : (
      <div class={`pj-grid pj-grid--${cols}`}>
        {projects.map((p, i) => (
          <article class={`pj-card reveal-card ${i===0?'pj-card--hero':''}`} style={`--cd:${i*0.08}s`} data-tilt>
            <a href={`/projects/${p.slug}`} class="pj-card__link" aria-label={`View ${p.title}`}>
              <div class="pj-card__img-wrap">
                {p.thumbnail_url
                  ? <img src={p.thumbnail_url} alt={p.title} class="pj-card__img" width="800" height="1000" loading={i===0?'eager':'lazy'} />
                  : <div class="pj-card__ph" aria-hidden="true"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="m21 15-5-5L5 21"/><circle cx="8.5" cy="8.5" r="1.5"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                }
                <div class="pj-card__grad" aria-hidden="true"></div>
              </div>
              <div class="pj-card__br pj-card__br--tl" aria-hidden="true"></div>
              <div class="pj-card__br pj-card__br--br" aria-hidden="true"></div>
              <div class="pj-card__glass">
                <div class="pj-card__meta">
                  <span class="pj-card__cat">{p.category}</span>
                  {p.is_featured && <span class="pj-card__badge">Featured</span>}
                </div>
                <h3 class="pj-card__title">{p.title}</h3>
                <p class="pj-card__desc">{p.short_description}</p>
                <div class="pj-card__tags">
                  {p.technologies.slice(0,4).map(t => <span class="pj-card__tag">{t}</span>)}
                  {p.technologies.length>4 && <span class="pj-card__tag">+{p.technologies.length-4}</span>}
                </div>
                <div class="pj-card__cta"><span>View Project</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
    <div class="projects__footer reveal"><a href="/projects" class="pj-btn">View all projects →</a></div>
  </div>
</section>
<link rel="stylesheet" href="/styles/projects.css" />
<script src="../scripts/projects.ts"></script>
