---
interface Project {
  id: string; title: string; slug: string; short_description: string;
  category: string; thumbnail_url?: string; technologies: string[];
  is_featured: boolean;
}
interface Props { projects?: Project[]; }
const { projects = [] } = Astro.props;
---
<section class="projects section" id="projects" aria-label="Projects section">
  <div class="container">
    <div class="projects__header reveal">
      <span class="section-label">02 / PROJECTS</span>
      <h2 class="projects__heading">Work that<br/><span class="text-gradient">speaks for itself.</span></h2>
      <p class="projects__subtext">Projects built to solve real problems and explore interesting ideas.</p>
    </div>
    {projects.length === 0 ? (
      <div class="projects__empty reveal">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
        <h3>Projects coming soon</h3>
        <p>Check back soon — I'm building something interesting.</p>
      </div>
    ) : (
      <div class="projects__grid">
        {projects.map((project, i) => (
          <article class={`project-card reveal delay-${Math.min(i+1,4)} ${i===0?'project-card--featured':''}`}>
            <a href={`/projects/${project.slug}`} class="project-card__link" aria-label={`View ${project.title}`}>
              <div class="project-card__img-wrap">
                {project.thumbnail_url
                  ? <img src={project.thumbnail_url} alt={project.title} class="project-card__img" width="800" height="450" loading={i===0?'eager':'lazy'} />
                  : <div class="project-card__placeholder" aria-hidden="true"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m21 15-5-5L5 21"/><circle cx="8.5" cy="8.5" r="1.5"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                }
                <div class="project-card__overlay" aria-hidden="true"><span>View Project</span></div>
              </div>
              <div class="project-card__body">
                <div class="project-card__meta">
                  <span class="project-card__cat">{project.category}</span>
                  {project.is_featured && <span class="tag">Featured</span>}
                </div>
                <h3 class="project-card__title">{project.title}</h3>
                <p class="project-card__desc">{project.short_description}</p>
                <div class="project-card__tech">
                  {project.technologies.slice(0,5).map(t => <span class="tag">{t}</span>)}
                  {project.technologies.length>5 && <span class="tag">+{project.technologies.length-5}</span>}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
    <div class="projects__footer reveal"><a href="/projects" class="btn btn--ghost">View all projects →</a></div>
  </div>
</section>

<style>
.projects__header{margin-bottom:3rem;max-width:640px}
.projects__heading{font-size:var(--text-5xl);margin-block:1rem}
.projects__subtext{font-size:var(--text-lg);color:var(--color-text-secondary)}
.projects__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}
@media(max-width:768px){.projects__grid{grid-template-columns:1fr}}
.project-card{background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:var(--radius-xl);overflow:hidden;transition:border-color var(--transition-normal),transform var(--transition-normal),box-shadow var(--transition-normal)}
.project-card:hover{border-color:rgba(183,148,246,.4);transform:translateY(-6px);box-shadow:var(--shadow-accent)}
.project-card--featured{grid-column:1/-1}
@media(max-width:768px){.project-card--featured{grid-column:auto}}
.project-card__link{display:block;text-decoration:none;color:inherit}
.project-card__img-wrap{position:relative;overflow:hidden;aspect-ratio:16/9;background:var(--color-bg-muted)}
.project-card--featured .project-card__img-wrap{aspect-ratio:21/9}
.project-card__img{width:100%;height:100%;object-fit:cover;transition:transform var(--transition-slow)}
.project-card:hover .project-card__img{transform:scale(1.05)}
.project-card__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-text-muted)}
.project-card__overlay{position:absolute;inset:0;background:rgba(183,148,246,0.1);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity var(--transition-normal)}
.project-card:hover .project-card__overlay{opacity:1}
.project-card__overlay span{font-size:var(--text-sm);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#F5F0FA;background:rgba(17,16,20,.8);padding:.5em 1.2em;border-radius:9999px;border:1px solid rgba(183,148,246,.4)}
.project-card__body{padding:1.5rem}
.project-card__meta{display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem}
.project-card__cat{font-size:var(--text-xs);font-weight:500;color:var(--color-text-muted);letter-spacing:.08em;text-transform:uppercase}
.project-card__title{font-size:var(--text-xl);font-weight:700;margin-bottom:.5rem;color:var(--color-text-primary)}
.project-card__desc{font-size:var(--text-sm);color:var(--color-text-secondary);line-height:1.8;margin-bottom:1rem}
.project-card__tech{display:flex;flex-wrap:wrap;gap:.5rem}
.projects__empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:5rem;text-align:center;border:1px dashed var(--color-border);border-radius:var(--radius-xl);color:var(--color-text-muted)}
.projects__empty h3{font-size:var(--text-xl);color:var(--color-text-secondary)}
.projects__footer{margin-top:2.5rem;display:flex;justify-content:center}
</style>
