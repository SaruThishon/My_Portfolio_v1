---
import type { Project } from '../types/api';
interface Props { projects?: Project[]; }
const { projects = [] } = Astro.props;
// Cap ring to 6 cards max — more than 6 makes the ring too wide and scroll too long.
// Extra projects are accessible via the /projects page.
const RING_MAX = 8; // show up to 8 in the ring
const ringProjects = projects.slice(0, RING_MAX);
const N = ringProjects.length;
---
<!-- Section header — normal page flow, scrolls away -->
<div class="pj-section-header container reveal" id="projects">
  <span class="section-label">02 / PROJECTS</span>
  <h2 class="pj-heading">Work that<br/><span class="text-gradient">speaks for itself.</span></h2>
  <p class="pj-subtext">Projects built to solve real problems and explore interesting ideas.</p>
</div>

{projects.length === 0 ? (
  <div class="container" style="padding-block:4rem">
    <div class="pj-empty reveal">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
      <h3>Projects coming soon</h3>
      <p>Check back soon — I'm building something interesting.</p>
    </div>
  </div>
) : (
  <div class="pj-track" id="pj-track" style={`--n:${N}`}>
    <div class="pj-stage" id="pj-stage">

      <!-- Progress dots (one per ring card, max 6) -->
      <div class="pj-progress" id="pj-progress" aria-hidden="true">
        {ringProjects.map((_, i) => (
          <span class={`pj-pdot${i===0?' is-active':''}`} data-i={i}></span>
        ))}
      </div>

      <!-- 3D ring of cards (max 6) -->
      <div class="pj-ring-wrap" id="pj-ring-wrap">
        <div class="pj-ring" id="pj-ring" style={`--n:${N}`}>
          {ringProjects.map((p, i) => (
            <article class="pj-card" style={`--i:${i};--n:${N}`} data-i={i}>
              <!-- Glare (follows mouse via --mx,--my on the card element) -->
              <div class="pj-card__glare" aria-hidden="true"></div>
              <!-- Corner brackets (animate in on hover) -->
              <span class="pj-card__br pj-card__br--tl" aria-hidden="true"></span>
              <span class="pj-card__br pj-card__br--br" aria-hidden="true"></span>
              <!-- Card content -->
              <a href={`/projects/${p.slug}`} class="pj-card__link" aria-label={`View ${p.title}`}>
                <div class="pj-card__top">
                  <span class="pj-card__cat">{p.category}</span>
                  {p.is_featured && <span class="pj-card__badge">Featured</span>}

                </div>
                <div class="pj-card__body">
                  <h3 class="pj-card__title">{p.title}</h3>
                  <p class="pj-card__desc">{p.short_description}</p>
                </div>
                <div class="pj-card__bottom">
                  <div class="pj-card__tags">
                    {p.technologies.slice(0,4).map(t => <span class="pj-card__tag">{t}</span>)}
                    {p.technologies.length>4 && <span class="pj-card__tag">+{p.technologies.length-4}</span>}
                  </div>
                  <span class="pj-card__cta" aria-hidden="true">View →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>

      <!-- Mobile fallback: simple vertical list (hidden on desktop) -->
      <div class="pj-mobile-list container" aria-label="Projects list">
        {projects.map((p, i) => (
          <a href={`/projects/${p.slug}`} class="pj-mob-card reveal">
            <div class="pj-mob-card__top">
              <span class="pj-mob-card__cat">{p.category}</span>
              {p.is_featured && <span class="pj-mob-card__badge">Featured</span>}

            </div>
            <h3 class="pj-mob-card__title">{p.title}</h3>
            <p class="pj-mob-card__desc">{p.short_description}</p>
            <div class="pj-mob-card__tags">
              {p.technologies.slice(0,4).map(t => <span class="pj-mob-card__tag">{t}</span>)}
            </div>
          </a>
        ))}
        <a href="/projects" class="pj-mob-view-all">View all projects →</a>
      </div>

      <!-- Scroll hint -->
      <div class="pj-hint" id="pj-hint" aria-hidden="true">
        <span class="pj-hint__line"></span>
        <span class="pj-hint__text">scroll</span>
      </div>

      <!-- View all -->
      <div class="pj-footer">
        <a href="/projects" class="pj-view-all">View all projects →</a>
      </div>

    </div>
  </div>
)}

<link rel="stylesheet" href="/styles/projects.css" />
<script src="../scripts/projects.ts"></script>
