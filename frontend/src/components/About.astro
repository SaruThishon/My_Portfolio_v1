---
interface Props {
  bio?: string;
  location?: string;
}
const {
  bio = "I'm a software engineering student passionate about Python, data, and building things that solve real problems. I love exploring the intersection of code and data — from writing clean SQL queries to training machine learning models.\n\nMy engineering philosophy is simple: start with curiosity, iterate with intention, and always prioritize understanding over memorization. I believe in learning by building and sharing what I learn along the way.\n\nCurrently focused on deepening my expertise in Python, PostgreSQL, and data science — while actively seeking opportunities to contribute to meaningful projects.",
  location = 'India',
} = Astro.props;
---

<section class="about section" id="about" aria-label="About section">
  <div class="container">
    <!-- Section header -->
    <div class="about__header reveal">
      <span class="section-label">01 / ABOUT</span>
    </div>

    <div class="about__grid">
      <!-- Left: Big heading -->
      <div class="about__left reveal-left">
        <h2 class="about__heading">
          A curious mind,<br/>
          <span class="text-gradient">engineering answers.</span>
        </h2>
        <div class="about__decorative" aria-hidden="true">
          <span class="about__line draw-line"></span>
          <div class="about__dot"></div>
        </div>
      </div>

      <!-- Right: Bio text -->
      <div class="about__right">
        <div class="about__bio reveal">
          {bio.split('\n\n').map((paragraph) => (
            <p class="about__paragraph">{paragraph}</p>
          ))}
        </div>

        <div class="about__meta reveal delay-2">
          <div class="about__meta-item">
            <span class="about__meta-label">Location</span>
            <span class="about__meta-value">{location}</span>
          </div>
          <div class="about__meta-item">
            <span class="about__meta-label">Focus</span>
            <span class="about__meta-value">Python · SQL · Data Science</span>
          </div>
          <div class="about__meta-item">
            <span class="about__meta-label">Status</span>
            <span class="about__meta-value about__meta-value--available">Available for opportunities</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Philosophy cards with stagger entrance -->
    <div class="about__values" data-stagger>
      <div class="about__value-card glow-pulse">
        <div class="about__value-number" data-count="1">01</div>
        <h3 class="about__value-title">Curiosity First</h3>
        <p class="about__value-text">Every good solution starts with the right question. I approach problems with genuine curiosity before writing a single line of code.</p>
      </div>
      <div class="about__value-card glow-pulse">
        <div class="about__value-number" data-count="2">02</div>
        <h3 class="about__value-title">Build to Learn</h3>
        <p class="about__value-text">Theory makes sense in practice. I learn best by building — breaking things, understanding why, and building them better the next time.</p>
      </div>
      <div class="about__value-card glow-pulse">
        <div class="about__value-number" data-count="3">03</div>
        <h3 class="about__value-title">Data-Informed</h3>
        <p class="about__value-text">Good decisions are grounded in data. I bring an analytical perspective to everything — from debugging code to evaluating design choices.</p>
      </div>
    </div>
  </div>
</section>

<style>
.about__header { margin-bottom: var(--space-12); }

.about__grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start;
  margin-bottom: var(--space-16);
}
@media (max-width: 768px) { .about__grid { grid-template-columns: 1fr; gap: var(--space-10); } }

.about__heading {
  font-size: var(--text-5xl); font-weight: 700;
  letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);
}
.about__decorative { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-8); }
.about__line { width: 64px; height: 1px; background: var(--color-accent-primary); }
.about__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent-primary); }

.about__bio { display: flex; flex-direction: column; gap: var(--space-4); }
.about__paragraph { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-text-secondary); }

.about__meta {
  display: flex; flex-direction: column; gap: var(--space-4);
  margin-top: var(--space-8); padding-top: var(--space-8);
  border-top: 1px solid var(--color-border);
}
.about__meta-item { display: flex; justify-content: space-between; align-items: center; }
.about__meta-label { font-size: var(--text-sm); color: var(--color-text-muted); font-weight: 500; }
.about__meta-value { font-size: var(--text-sm); color: var(--color-text-primary); font-weight: 500; }
.about__meta-value--available { color: var(--color-success); }

.about__values {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6);
}
@media (max-width: 1024px) { .about__values { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .about__values { grid-template-columns: 1fr; } }

.about__value-card {
  background: var(--color-bg-card); border: 1px solid var(--color-border);
  border-radius: var(--radius-xl); padding: var(--space-8);
  transition: border-color var(--transition-normal), transform var(--transition-normal);
}
.about__value-card:hover {
  border-color: rgba(183,148,246,.4); transform: translateY(-4px);
}
.about__value-number {
  font-family: var(--font-heading); font-size: var(--text-xs);
  font-weight: 700; letter-spacing: var(--tracking-widest);
  color: var(--color-accent-primary); margin-bottom: var(--space-4);
}
.about__value-title {
  font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-3);
  color: var(--color-text-primary);
}
.about__value-text { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--leading-relaxed); }
</style>
