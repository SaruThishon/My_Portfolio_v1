---
interface Props {
  name?: string;
  title?: string;
  description?: string;
  profileImageUrl?: string;
  location?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  email?: string;
  updatedAt?: string;
}
const {
  name = 'Your Name',
  title = 'Software Engineer',
  description = 'Exploring the world of Python, databases and data science. Building practical solutions through code, curiosity and continuous learning.',
  profileImageUrl = '',
  location = '',
  githubUrl = '',
  linkedinUrl = '',
  email = '',
  updatedAt = '',
} = Astro.props;

// Compute activity status server-side — no client JS needed
function getActivityStatus(iso: string) {
  if (!iso) return { label: 'Active', dot: '#4ADE80', dimmed: false };
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
  if (days < 1)  return { label: 'Active today',           dot: '#4ADE80', dimmed: false };
  if (days < 7)  return { label: `Active · ${days}d ago`,  dot: '#4ADE80', dimmed: false };
  if (days < 30) return { label: `Active · ${Math.floor(days / 7)}w ago`, dot: '#FBBF24', dimmed: false };
  return               { label: `Away · ${Math.floor(days / 30)}mo ago`,  dot: '#6B6475', dimmed: true };
}
const activity = getActivityStatus(updatedAt);

// Split name for large display — first name white, last name violet gradient
const nameParts = name.trim().split(' ');
const firstName = nameParts[0] || name;
const lastName  = nameParts.slice(1).join(' ');

const hasImage = !!profileImageUrl;

// Split title on comma or slash for the rotating animation
// e.g. "Software Engineer, ML Engineer, Data Analyst"  →  ["Software Engineer", "ML Engineer", "Data Analyst"]
const titleParts = title
  .split(/[,\/]/)
  .map((t: string) => t.trim())
  .filter(Boolean);
// Pass as JSON to the client script
const titlesJson = JSON.stringify(titleParts);
---
<section class="hero" id="home" aria-label="Hero section">

  <!-- Background layer -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-grid"></div>
    <div class="hero__bg-orb hero__bg-orb--1"></div>
    <div class="hero__bg-orb hero__bg-orb--2"></div>
  </div>

  <!-- Two-column grid: portrait left, content right -->
  <div class={`container hero__container ${hasImage ? 'hero__container--with-image' : ''}`}>

    <!-- Portrait column (left) — only rendered when profile image is set -->
    {hasImage && (
      <div class="hero__portrait-col hero__portrait-enter" aria-hidden="true">
        <div class="hero__portrait-glow"></div>
        <div class="hero__portrait-img-wrap">
          <img
            src={profileImageUrl}
            alt=""
            class="hero__portrait-img"
            width="520"
            height="680"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    )}

    <!-- Content column (right when portrait exists, full width when not) -->
    <div class="hero__content">

      <!-- Name — the dominant element -->
      <div class="hero__name-wrap hero__enter-1">
        <h1 class="hero__name-display">
          <span class="hero__firstname">{firstName}</span>
          {lastName && <span class="hero__lastname">{lastName}</span>}
        </h1>
      </div>

      <!-- Title — rotates through comma/slash separated values -->
      <div class="hero__title-wrap hero__enter-2" aria-live="polite">
        <span class="hero__title-static" aria-hidden="true">{titleParts[0] || title}</span>
        <span class="hero__title-rotating" id="hero-title-rotating" aria-label={title}>
          {titleParts[0] || title}
        </span>
      </div>

      <!-- Location + activity status — below title -->
      <div class="hero__meta hero__enter-3">
        {location && (
          <span class="hero__meta-loc">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {location.trim()}
          </span>
        )}
        <span class="hero__meta-sep" aria-hidden="true">·</span>
        <span class="hero__meta-status">
          <span class="hero__status-dot" style={`background:${activity.dot}`} aria-hidden="true"></span>
          <span style={activity.dimmed ? 'color:#6B6475' : ''}>{activity.label}</span>
        </span>
      </div>

      <!-- Description -->
      <p class="hero__description hero__enter-4">{description}</p>

      <!-- CTAs -->
      <div class="hero__actions hero__enter-5">
        <a href="/#projects" class="btn btn--primary">
          Explore Projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/#contact" class="btn btn--ghost">Let's Talk</a>
      </div>

      <!-- Social links -->
      <div class="hero__social hero__enter-6">
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hero__social-link" aria-label="GitHub">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        )}
        {linkedinUrl && (
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="hero__social-link" aria-label="LinkedIn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        )}
        {email && (
          <a href={`mailto:${email}`} class="hero__social-link" aria-label="Email">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </a>
        )}
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-text">scroll</span>
  </div>

</section>
<link rel="stylesheet" href="/styles/hero.css" />
<link rel="stylesheet" href="/styles/hero2.css" />

<script define:vars={{ titlesJson }}>
  // Rotating title animation
  // Only runs if there are multiple title parts
  (function() {
    var titles;
    try { titles = JSON.parse(titlesJson); } catch(e) { return; }
    if (!titles || titles.length <= 1) return;

    var el = document.getElementById('hero-title-rotating');
    if (!el) return;

    var current = 0;
    var HOLD_MS  = 2400;   // visible duration per title
    var OUT_MS   = 350;    // exit animation duration
    var IN_MS    = 350;    // enter animation duration

    function rotateTo(index) {
      // Exit: slide up + fade out
      el.style.transition = 'opacity ' + OUT_MS + 'ms ease, transform ' + OUT_MS + 'ms cubic-bezier(0.4,0,1,1)';
      el.style.opacity    = '0';
      el.style.transform  = 'translateY(-12px)';

      setTimeout(function() {
        // Swap text while invisible — start below
        el.textContent = titles[index];
        el.style.transition = 'none';
        el.style.transform  = 'translateY(14px)';
        el.style.opacity    = '0';

        // Force reflow so the browser registers the starting position
        void el.offsetHeight;

        // Enter: slide up + fade in
        el.style.transition = 'opacity ' + IN_MS + 'ms ease, transform ' + IN_MS + 'ms cubic-bezier(0,0,0.2,1)';
        el.style.opacity    = '1';
        el.style.transform  = 'translateY(0)';
      }, OUT_MS);
    }

    // Start cycling after the initial hold period
    setInterval(function() {
      current = (current + 1) % titles.length;
      rotateTo(current);
    }, HOLD_MS + OUT_MS);

    // Respect reduced-motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = titles.join(' · ');
    }
  })();
</script>
