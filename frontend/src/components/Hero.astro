---
interface Props {
  name?: string; title?: string; headline?: string; description?: string;
  isAvailable?: boolean; availabilityText?: string;
  githubUrl?: string; linkedinUrl?: string; email?: string;
}
const {
  name = 'Your Name', title = 'Software Engineer',
  headline = 'CURIOUS BY NATURE.\nENGINEERED TO BUILD.',
  description = 'Exploring the world of Python, databases and data science. Building practical solutions through code, curiosity and continuous learning.',
  isAvailable = true, availabilityText = 'Open to opportunities',
  githubUrl = '', linkedinUrl = '', email = '',
} = Astro.props;
---
<section class="hero" id="home" aria-label="Hero section">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-gradient"></div>
    <div class="hero__bg-grid"></div>
    <div class="hero__bg-orb hero__bg-orb--1"></div>
    <div class="hero__bg-orb hero__bg-orb--2"></div>
  </div>
  <div class="container hero__container">
    <div class="hero__content">
      <div class="hero__badge reveal delay-1" aria-live="polite">
        <span class={`hero__badge-dot ${isAvailable ? 'is-available' : ''}`} aria-hidden="true"></span>
        <span>{availabilityText}</span>
      </div>
      <h1 class="hero__headline reveal delay-2">
        {headline.split('\n').map((line, i) => (
          <span class="hero__headline-line">
            {i === 0 ? line : <span class="text-gradient">{line}</span>}
          </span>
        ))}
      </h1>
      <div class="hero__identity reveal delay-3">
        <span class="hero__name">{name}</span>
        <span class="hero__sep" aria-hidden="true">—</span>
        <span class="hero__title-text">{title}</span>
      </div>
      <p class="hero__description reveal delay-4">{description}</p>
      <div class="hero__actions reveal delay-5">
        <a href="/#projects" class="btn btn--primary magnetic-btn">Explore Projects <span aria-hidden="true">→</span></a>
        <a href="/#contact" class="btn btn--ghost">Let's Talk</a>
      </div>
      <div class="hero__social reveal">
        <span class="hero__social-label">Find me on</span>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hero__social-link" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        )}
        {linkedinUrl && (
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="hero__social-link" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        )}
        {email && (
          <a href={`mailto:${email}`} class="hero__social-link" aria-label="Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </a>
        )}
      </div>
    </div>
    <div class="hero__visual reveal-scale delay-2" aria-hidden="true">
      <div class="hero__visual-inner">
        <div class="hero__vs hero__vs--1"></div>
        <div class="hero__vs hero__vs--2"></div>
        <div class="hero__vs hero__vs--3"></div>
        <div class="hero__visual-code">
          <div class="code-block">
            <span class="cl"><span class="ckw">def</span> <span class="cfn">engineer</span>():</span>
            <span class="cl">  curiosity <span class="cop">=</span> <span class="cst">True</span></span>
            <span class="cl">  skills <span class="cop">=</span> [</span>
            <span class="cl">    <span class="cst">"Python"</span>,</span>
            <span class="cl">    <span class="cst">"SQL"</span>,</span>
            <span class="cl">    <span class="cst">"Data Science"</span>,</span>
            <span class="cl">  ]</span>
            <span class="cl">  <span class="ckw">return</span> build(skills)</span>
            <span class="cc">|</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-text">scroll</span>
  </div>
</section>
<link rel="stylesheet" href="/styles/hero.css" />
